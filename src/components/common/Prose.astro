---
export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["container-editorial max-w-3xl py-12 md:py-20", className]}>
  <div class="text-ink/85 [&_a:hover]:text-forest [&_h2]:text-ink space-y-6 text-[15px] leading-[1.75] [&_a]:underline [&_a]:underline-offset-4 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:font-serif [&_h2]:text-2xl [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:ps-6">
    <slot />
  </div>
</div>
