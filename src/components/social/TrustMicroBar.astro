---
/** Compact one-line trust bar for footer / cart / checkout headers. */
import Stars from "@/components/common/Stars.astro";
import { stats } from "@/data/reviews";
import { createT, withLocalePrefix } from "@/lib/i18n";

const { locale } = Astro.locals;
const t = createT(locale);
---

<a
  href={withLocalePrefix("/reviews", locale)}
  class="bg-forest text-paper hover:bg-moss block transition-colors"
>
  <div class="container-editorial flex items-center justify-center gap-3 py-2.5 text-[10px] font-semibold tracking-[0.2em] uppercase md:text-[11px]">
    <Stars n={5} size="sm" />
    <span data-ltr>{stats.rating} / 5</span>
    <span class="opacity-50">·</span>
    <span class="tabular-nums">
      {stats.count.toLocaleString()}
      {t("product.trustbar.verifiedRatings", "verified ratings")}
    </span>
    <span class="hidden opacity-50 sm:inline">·</span>
    <span class="hidden sm:inline">
      {stats.countries}+ {t("product.trustbar.countries", "countries")}
    </span>
  </div>
</a>
