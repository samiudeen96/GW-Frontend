---
/** Editorial section heading with an optional sub line. */
export interface Props {
  title: string;
  sub?: string;
}

const { title, sub } = Astro.props;
---

<div class="border-forest/15 mb-5 max-w-3xl border-b pb-4 md:mb-8">
  <h2 class="text-forest font-serif text-2xl leading-[1.05] md:text-[2rem]">{title}</h2>
  {sub && <p class="text-forest/75 mt-3 font-serif text-[13.5px] leading-[1.7]">{sub}</p>}
</div>
