---
/** "Botanical. Not pharmaceutical." comparison (Neo Hair Lotion only). */
import { createT } from "@/lib/i18n";

import Eyebrow from "./Eyebrow.astro";

const t = createT(Astro.locals.locale);
const c = (key: string, fallback: string) => t(`product.route.compare.${key}`, fallback);

type Row = [criterion: string, neo: string, minoxidil: string, finasteride: string];

const formulation: Row = [
  c("formulation", "Formulation"),
  c("formulationNeo", "5 botanical extracts"),
  c("formulationMino", "Synthetic vasodilator"),
  c("formulationFina", "Systemic 5-α inhibitor"),
];
const mechanism: Row = [
  c("mechanism", "Mechanism"),
  c("mechanismNeo", "DHT + VEGF + anti-inflammatory + keratin"),
  c("mechanismMino", "Vasodilation only"),
  c("mechanismFina", "Blocks DHT systemically"),
];
const application: Row = [
  c("application", "Application"),
  c("applicationNeo", "Leave-in spray, 6–8 mists AM/PM"),
  c("applicationMino", "Topical, 2× daily"),
  c("applicationFina", "Oral tablet, daily"),
];
const withdrawal: Row = [
  c("withdrawalShedding", "Withdrawal shedding"),
  c("withdrawalSheddingNeo", "None reported"),
  c("withdrawalSheddingMino", "Yes — dread shed"),
  c("withdrawalSheddingFina", "Yes — on cessation"),
];
const women: Row = [
  c("suitableForWomen", "Suitable for women"),
  c("suitableForWomenNeo", "Yes — all ages"),
  c("suitableForWomenMino", "Yes (2%)"),
  c("suitableForWomenFina", "Contraindicated"),
];

const tableRows: Row[] = [
  formulation,
  mechanism,
  application,
  withdrawal,
  [
    c("hormonalSideEffects", "Hormonal side effects"),
    c("hormonalSideEffectsNeo", "None (topical, plant-based)"),
    c("hormonalSideEffectsMino", "None (topical)"),
    c("hormonalSideEffectsFina", "Libido / mood changes reported"),
  ],
  [
    c("scalpDryness", "Scalp dryness / irritation"),
    c("scalpDrynessNeo", "None — soothing botanicals"),
    c("scalpDrynessMino", "Common (propylene glycol)"),
    c("scalpDrynessFina", "N/A (oral)"),
  ],
  women,
  [
    c("prescriptionRequired", "Prescription required"),
    c("prescriptionRequiredNeo", "No"),
    c("prescriptionRequiredMino", "OTC / Rx (region)"),
    c("prescriptionRequiredFina", "Yes"),
  ],
];

const cardRows: Row[] = [
  formulation,
  mechanism,
  application,
  withdrawal,
  [
    c("sideEffectsShort", "Side effects"),
    c("sideEffectsShortNeo", "None (plant-based)"),
    c("sideEffectsShortMino", "Scalp irritation"),
    c("sideEffectsShortFina", "Libido / mood reported"),
  ],
  women,
  [
    c("prescriptionShort", "Prescription"),
    c("prescriptionShortNeo", "No"),
    c("prescriptionShortMino", "OTC / Rx"),
    c("prescriptionShortFina", "Yes"),
  ],
];
---

<section class="hairline bg-paper border-t">
  <div class="container-editorial py-7 md:py-14">
    <div class="border-forest/15 mb-5 max-w-3xl border-b pb-4 md:mb-8">
      <Eyebrow>{t("product.route.anHonestComparison", "An honest comparison")}</Eyebrow>
      <h2 class="text-forest mt-3 font-serif text-2xl leading-[1.05] tracking-[-0.015em] md:text-[2rem]">
        {t("product.route.botanicalNotPharma", "Botanical. Not pharmaceutical.")}
      </h2>
    </div>

    <div class="hidden overflow-x-auto lg:block">
      <table class="w-full min-w-[720px] border-collapse text-start">
        <thead>
          <tr class="border-forest/25 border-b">
            <th class="text-forest/60 w-[30%] p-4 align-bottom font-mono text-[10px] tracking-[0.24em] uppercase">
              {t("product.route.criterion", "Criterion")}
            </th>
            <th class="bg-forest text-paper p-4 align-bottom">
              <div class="text-gold mb-1 font-mono text-[10px] tracking-[0.28em] uppercase">
                {t("product.route.greenWealth", "Green Wealth")}
              </div>
              <div class="font-serif text-lg leading-tight">
                {t("product.route.neoHairLotion", "Neo Hair Lotion")}
              </div>
            </th>
            <th class="p-4 align-bottom">
              <div class="text-forest/50 mb-1 font-mono text-[10px] tracking-[0.24em] uppercase">
                {t("product.route.rxOtc", "Rx / OTC")}
              </div>
              <div class="text-forest/70 font-serif text-base leading-tight">
                {t("product.route.minoxidil5", "Minoxidil 5%")}
              </div>
            </th>
            <th class="p-4 align-bottom">
              <div class="text-forest/50 mb-1 font-mono text-[10px] tracking-[0.24em] uppercase">
                {t("product.route.prescription", "Prescription")}
              </div>
              <div class="text-forest/70 font-serif text-base leading-tight">
                {t("product.route.finasteride1mg", "Finasteride 1 mg")}
              </div>
            </th>
          </tr>
        </thead>
        <tbody class="text-[13px]">
          {tableRows.map(([crit, neo, mino, fina], rIdx) => (
            <tr class:list={["border-forest/10 border-b", rIdx % 2 === 1 && "bg-ivory/50"]}>
              <td class="text-forest/70 p-3.5 align-top font-mono text-[11px] tracking-[0.16em] uppercase">
                {crit}
              </td>
              <td class="bg-forest/[0.04] text-forest p-3.5 align-top leading-snug font-semibold">
                {neo}
              </td>
              <td class="text-forest/70 p-3.5 align-top leading-snug">{mino}</td>
              <td class="text-forest/70 p-3.5 align-top leading-snug">{fina}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="space-y-3 lg:hidden">
      {cardRows.map(([crit, neo, mino, fina]) => (
        <div class="border-forest/10 bg-paper border">
          <div class="border-forest/10 bg-forest/[0.03] border-b px-3 py-2">
            <span class="text-forest/60 font-mono text-[10px] tracking-[0.2em] uppercase">
              {crit}
            </span>
          </div>
          <div class="divide-forest/10 grid grid-cols-3 divide-x">
            <div class="bg-forest/[0.04] p-2.5">
              <span class="text-gold mb-1 block font-mono text-[9px] tracking-[0.18em] uppercase">
                {t("product.route.neoLabel", "Neo")}
              </span>
              <span class="text-forest text-[11.5px] leading-snug font-semibold">{neo}</span>
            </div>
            <div class="p-2.5">
              <span class="text-forest/45 mb-1 block font-mono text-[9px] tracking-[0.16em] uppercase">
                {t("product.route.minoxidilLabel", "Minoxidil")}
              </span>
              <span class="text-forest/70 text-[11.5px] leading-snug">{mino}</span>
            </div>
            <div class="p-2.5">
              <span class="text-forest/45 mb-1 block font-mono text-[9px] tracking-[0.16em] uppercase">
                {t("product.route.finasterideLabel", "Finasteride")}
              </span>
              <span class="text-forest/70 text-[11.5px] leading-snug">{fina}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <p class="text-forest/50 mt-4 font-mono text-[10px] tracking-[0.18em] uppercase">
      {t("product.route.basedOnLiterature", "* Based on published literature. Not medical advice.")}
    </p>
  </div>
</section>
