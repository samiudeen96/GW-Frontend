---
/**
 * PDP hero, three columns on desktop: scientific ledger | gallery | buy box.
 * On mobile: gallery, buy box, then the ledger.
 */
import type { Product } from "@/data/products";
import { createT } from "@/lib/i18n";
import { islandImage } from "@/lib/images";
import { getCurrency, getTiers } from "@/lib/pricing";

import BuyBox from "./BuyBox";
import FrequentlyPaired from "./FrequentlyPaired.astro";
import HeroLedger from "./HeroLedger.astro";
import MobileLedger from "./MobileLedger.astro";
import ProductGallery, { type GalleryImage } from "./ProductGallery";
import RatingSummary from "./RatingSummary.astro";
import {
  altFor,
  etaFor,
  formatEtaWindow,
  ledgerData,
  productGallery,
  productSku,
  productStat,
  productT,
  reviewsForProduct,
  translateEta,
  translateReview,
} from "./product-helpers";

export interface Props {
  product: Product;
  related: Product[];
}

const { product: p, related } = Astro.props;
const { locale, currency } = Astro.locals;
const t = createT(locale);
const tp = productT(t, p.slug);
const pName = tp("name", p.name);
const sku = productSku(p);
const tiers = getTiers(p.slug, currency);
const curMeta = getCurrency(currency);
const ledger = ledgerData(p, t);
const voices = reviewsForProduct(p.slug)
  .slice(0, 3)
  .map((r) => translateReview(r, t));

const images: GalleryImage[] = await Promise.all(
  productGallery(p).map(async (src, i) => ({
    ...(await islandImage(src, { widths: [160, 400, 800, 1200] })),
    alt: altFor(p, i, t),
  })),
);

const rating = productStat(p.slug)?.rating ?? 4.9;
const days = etaFor(curMeta.country);
---

<section class="hairline border-b lg:grid lg:h-[calc(100dvh-180px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)_minmax(0,1fr)] lg:overflow-hidden">
  <HeroLedger product={p} sku={sku} data={ledger} voices={voices} />

  <div class="hairline relative overflow-hidden border-b bg-white lg:h-[calc(100dvh-180px)] lg:overflow-y-auto lg:border-e lg:border-b-0">
    <ProductGallery
      client:idle
      images={images}
      brand={p.brand ?? "Green Wealth"}
      name={pName}
      labels={{
        authentic: t("product.route.authentic", "Authentic"),
        botanicalTech: t("product.route.botanicalTech", "Botanical Tech"),
        viewImage: t("product.route.viewImage", "View image"),
      }}
    >
      <RatingSummary slug={p.slug} />
    </ProductGallery>
  </div>

  <div class="bg-forest text-paper flex flex-col lg:h-[calc(100dvh-180px)] lg:overflow-y-auto">
    <BuyBox
      client:load
      slug={p.slug}
      available={p.available}
      currency={currency}
      tiers={tiers}
      header={{
        category: tp("category", p.category),
        sku,
        tagline: tp("tagline", p.tagline ?? ""),
        name: pName,
        rating,
        sizeLine: `${tp("size", p.size)} · ${curMeta.code}`,
      }}
      delivery={{
        title: `${t("product.route.deliveryTo", "Delivery to")} ${
          curMeta.country
            ? t(`region.country.${curMeta.code}`, curMeta.country)
            : t("product.route.yourRegion", "your region")
        }`,
        arrival: t("product.route.estimatedArrival", "Estimated arrival"),
        window: formatEtaWindow(days, locale),
        days: `${translateEta(t, days)} · ${t("product.route.tracked", "tracked")}`,
        orderIn: t("product.route.orderIn", "Order in"),
        next24h: t("product.route.next24h", "next 24h"),
        shipsToday: t("product.route.shipsToday", "ships today"),
      }}
      pillars={[
        {
          k: t("product.route.freeShipping", "Free shipping"),
          v: t("product.route.worldwideTracked", "Worldwide, tracked"),
        },
        {
          k: t("product.route.sevenDayReturns", "7-day returns"),
          v: t("product.route.unopenedBottles", "Unopened bottles"),
        },
        {
          k: t("product.route.secureCheckout", "Secure checkout"),
          v: t("product.route.sslEncryption", "256-bit SSL"),
        },
        {
          k: t("product.route.authentic", "Authentic"),
          v: t("product.route.scratchCodeVerified", "Scratch-code verified"),
        },
      ]}
      labels={{
        save: t("product.route.save", "Save"),
        inclTaxes: t("product.route.inclTaxes", "Incl. taxes"),
        freeShipWorldwide: t("product.route.freeShipWorldwide", "Free ship worldwide"),
        choosePack: t("product.route.choosePackBulkPricing", "Choose your pack · bulk pricing"),
        unit: t("product.route.unit", "unit"),
        units: t("product.route.units", "units"),
        quantity: t("product.route.quantity", "Quantity"),
        decrease: t("product.route.decrease", "Decrease"),
        increase: t("product.route.increase", "Increase"),
        addToBag: t("product.route.addToBag", "Add to Bag"),
        unavailable: t("product.route.unavailable", "Unavailable"),
        buyItNow: t("product.route.buyItNow", "Buy it now"),
        taxes: t("product.route.taxes", "Taxes"),
        incl: t("product.route.incl", "Incl."),
        shipping: t("product.route.shipping", "Shipping"),
        freeWorldwide: t("product.route.freeWorldwide", "Free worldwide"),
        youSave: t("product.route.youSave", "You save"),
        total: t("product.route.total", "Total"),
        verifiedRating: t("product.route.verifiedRating", "Verified rating"),
      }}
    />
    <FrequentlyPaired related={related} />
  </div>

  <MobileLedger sku={sku} data={ledger} />
</section>
