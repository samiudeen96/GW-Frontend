---
/** Verified-review score and star distribution under the desktop gallery. */
import { stats } from "@/data/reviews";
import { createT } from "@/lib/i18n";

import { productStat, ratingDistribution } from "./product-helpers";

export interface Props {
  slug: string;
}

const { slug } = Astro.props;
const t = createT(Astro.locals.locale);
const ps = productStat(slug) ?? { rating: stats.rating, count: stats.count };
const r = ps.rating;
const dist = ratingDistribution(r);
const link =
  "text-center py-3.5 text-[10px] uppercase tracking-[0.22em] font-mono transition-colors";
---

<div class="hairline bg-paper border-t">
  <div class="hairline flex items-center border-b px-5 py-3">
    <p class="text-gold font-mono text-[9.5px] tracking-[0.28em] uppercase">
      {t("product.route.verifiedReviews", "Verified Reviews")}
    </p>
  </div>

  <div class="grid grid-cols-1 items-stretch sm:grid-cols-[auto_1fr]">
    <div class="hairline flex items-center gap-4 px-5 py-6 sm:flex-col sm:items-start sm:gap-2 sm:border-e sm:pe-7">
      <div class="text-forest font-serif text-[46px] leading-none tabular-nums">{r.toFixed(1)}</div>
      <div>
        <div
          class="flex gap-1"
          aria-label={`${r.toFixed(1)} ${t("product.route.outOfFive", "out of 5")}`}
        >
          {Array.from({ length: 5 }).map((_, i) => (
            <span class:list={["h-2.5 w-2.5", i < Math.round(r) ? "bg-gold" : "bg-forest/15"]} />
          ))}
        </div>
        <p class="text-forest/55 mt-2 font-mono text-[9.5px] tracking-[0.2em] uppercase tabular-nums">
          {ps.count.toLocaleString()}+ {t("product.route.reviews", "reviews")}
        </p>
      </div>
    </div>

    <div class="space-y-2 px-5 py-6">
      {dist.map((row) => (
        <div class="flex items-center gap-3">
          <span class="text-forest/55 w-6 font-mono text-[9.5px] tabular-nums">{row.stars}★</span>
          <div class="bg-forest/8 h-[5px] flex-1 overflow-hidden">
            <div class="bg-forest h-full" style={`width:${row.pct}%`}></div>
          </div>
          <span class="text-forest/45 w-8 text-end font-mono text-[9.5px] tabular-nums">
            {row.pct}%
          </span>
        </div>
      ))}
    </div>
  </div>

  <div class="hairline grid grid-cols-2 -space-x-px border-t">
    <a
      href="#reviews"
      class:list={[link, "text-forest/70 hover:text-forest hover:bg-ivory hairline border-e"]}
    >
      {t("product.route.readReviews", "Read reviews")}
    </a>
    <a
      href="#reviews"
      class:list={[link, "text-forest hover:bg-forest hover:text-paper font-bold"]}
    >
      {t("product.route.writeAReview", "Write a review")}
    </a>
  </div>
  <p class="hairline text-forest/40 border-t px-5 py-3 font-mono text-[9px] tracking-[0.18em] uppercase">
    {t("product.route.combinedAcrossChannels", "Combined across all channels")}
  </p>
</div>
