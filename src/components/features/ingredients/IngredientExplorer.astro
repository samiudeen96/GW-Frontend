---
/**
 * Filterable glossary on /ingredients: search, product filter, theme tabs, the
 * numbered card grid and the alphabetical index. Everything is server-rendered;
 * a small script hides non-matching entries and renumbers the visible cards.
 */
import ResponsiveImage from "@/components/common/ResponsiveImage.astro";
import { ingredientExtras } from "@/data/ingredient-extras";
import type { IngredientEntry } from "@/data/ingredients";
import type { Product } from "@/data/products";
import { createT, withLocalePrefix } from "@/lib/i18n";

import { ingT, stripBrand, THEMES } from "./utils";

export interface Props {
  ingredients: IngredientEntry[];
  products: Product[];
}

const { ingredients, products } = Astro.props;
const { locale } = Astro.locals;
const t = createT(locale);
const ing = ingT(t);
const productBySlug = new Map(products.map((p) => [p.slug, p]));
const tagsOf = (slug: string) => ingredientExtras[slug]?.tags ?? [];
const pad = (n: number) => String(n).padStart(2, "0");

const themes = THEMES.map((th) => ({
  ...th,
  count:
    th.id === "all"
      ? ingredients.length
      : ingredients.filter((i) => th.match(tagsOf(i.slug))).length,
}));

const cards = ingredients.map((i) => {
  const tags = tagsOf(i.slug);
  return {
    i,
    extras: ingredientExtras[i.slug],
    themes: THEMES.filter((th) => th.match(tags))
      .map((th) => th.id)
      .join(" "),
    hay: `${i.name} ${i.latin ?? ""} ${i.summary ?? ""} ${i.description ?? ""} ${tags.join(" ")}`.toLowerCase(),
  };
});

const groups = new Map<string, IngredientEntry[]>();
for (const i of ingredients) {
  const letter = i.name[0].toUpperCase();
  groups.set(letter, [...(groups.get(letter) ?? []), i]);
}
const alphaGroups = [...groups.entries()].sort(([a], [b]) => a.localeCompare(b));

const showingTemplate = t("ingx.showing", "Showing {a} of {b} entries");
const showing = (a: number) =>
  showingTemplate.replace("{a}", String(a)).replace("{b}", String(ingredients.length));
const chip =
  "hairline border px-2 py-1 font-mono text-[10px] tracking-[0.24em] whitespace-nowrap uppercase text-forest/70 not-aria-pressed:hover:bg-ivory aria-pressed:bg-forest aria-pressed:text-paper aria-pressed:border-forest";
const resetLabel = t("ingx.reset", "reset filters →");
---

<div
  data-ing-explorer
  data-total={ingredients.length}
  data-showing={showingTemplate}
  class="contents"
>
  {/* ═════════════ Filters ═════════════ */}
  <section class="container-editorial mt-10 md:mt-14">
    <div class="hairline bg-paper border">
      {/* Search + product filter row */}
      <div class="bg-ink/10 grid grid-cols-1 gap-px md:grid-cols-[1.4fr_1fr]">
        <label class="bg-paper flex items-center gap-3 px-4 py-3">
          <span class="text-forest/50 shrink-0 font-mono text-[9.5px] tracking-[0.28em] uppercase">
            {t("ingx.search", "Search")}
          </span>
          <input
            data-ing-query
            placeholder={t("ingx.searchPlaceholder", "e.g. ginseng, silica, scalp barrier…")}
            class="text-forest placeholder:text-forest/35 min-w-0 flex-1 bg-transparent text-[13px] outline-none"
          />
          <button
            type="button"
            data-ing-clear
            hidden
            class="text-forest/50 hover:text-forest font-mono text-[10px]"
            aria-label={t("ingx.clearAria", "Clear search")}
          >
            {t("ingx.clear", "clear ×")}
          </button>
        </label>
        <div class="bg-paper flex items-center gap-2 overflow-x-auto px-4 py-3">
          <span class="text-forest/50 shrink-0 font-mono text-[9.5px] tracking-[0.28em] uppercase">
            {t("ingx.inProduct", "In product")}
          </span>
          <button type="button" data-ing-product="all" aria-pressed="true" class={chip}>
            {t("ingx.all", "All")}
          </button>
          {products.map((p) => (
            <button type="button" data-ing-product={p.slug} aria-pressed="false" class={chip}>
              {stripBrand(t(`product.${p.slug}.name`, p.name))}
            </button>
          ))}
        </div>
      </div>

      {/* Theme tabs */}
      <div class="hairline bg-ink/10 grid grid-cols-2 gap-px border-t sm:grid-cols-5">
        {themes.map((th) => (
          <button
            type="button"
            data-ing-theme={th.id}
            aria-pressed={th.id === "all" ? "true" : "false"}
            class="group bg-paper text-forest not-aria-pressed:hover:bg-ivory aria-pressed:bg-forest aria-pressed:text-paper px-3 py-3 text-start transition-colors"
          >
            <div class="text-forest/50 group-aria-pressed:text-gold font-mono text-[9px] tracking-[0.28em] uppercase">
              {pad(th.count)}
            </div>
            <div class="mt-1 text-[11.5px] leading-tight">{t(`ingx.theme.${th.id}`, th.label)}</div>
          </button>
        ))}
      </div>
    </div>

    <div class="text-forest/55 mt-3 flex items-center justify-between font-mono text-[10px] tracking-[0.28em] uppercase">
      <span data-ing-showing>{showing(ingredients.length)}</span>
      <button type="button" data-ing-reset hidden class="hover:text-moss">
        {resetLabel}
      </button>
    </div>
  </section>

  {/* ═════════════ Grid ═════════════ */}
  <section class="container-editorial mt-6 md:mt-8">
    <div data-ing-empty hidden class="hairline bg-paper border p-10 text-center">
      <div class="eyebrow text-moss">{t("ingx.noMatches", "No matches")}</div>
      <div class="text-forest mt-2 font-serif text-2xl">
        {t("ingx.nothingFound", "Nothing found for those filters.")}
      </div>
      <button
        type="button"
        data-ing-reset-all
        class="border-forest text-forest hover:bg-forest hover:text-paper mt-4 inline-block border px-5 py-2.5 font-mono text-[10px] tracking-[0.28em] uppercase transition-colors"
      >
        {t("ingx.resetFilters", "Reset filters")}
      </button>
    </div>
    <div
      data-ing-grid
      class="bg-ink/10 hairline grid grid-cols-1 gap-px border md:grid-cols-2 lg:grid-cols-3"
    >
      {cards.map(({ i, extras, themes: themeIds, hay }, idx) => (
        <a
          href={withLocalePrefix(`/ingredients/${i.slug}`, locale)}
          data-ing-card={i.slug}
          data-themes={themeIds}
          data-products={i.productSlugs.join(" ")}
          data-hay={hay}
          class="group bg-paper relative block overflow-hidden"
        >
          <div class="bg-ivory relative aspect-[4/3] overflow-hidden">
            {i.image ? (
              <ResponsiveImage
                src={i.image}
                alt={`${ing(i.name)} — ${t("img.ingredientAltCare", "botanical active in Green Wealth hair care")}`}
                title={ing(i.name)}
                sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                class="h-full w-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.06]"
              />
            ) : (
              <div class="grid h-full w-full place-items-center">
                <div class="text-forest/15 font-serif text-6xl">{i.name[0]}</div>
              </div>
            )}
            <div class="text-forest/70 bg-paper/85 hairline absolute start-2 top-2 border px-2 py-0.5 font-mono text-[9px] tracking-[0.28em] uppercase">
              {t("ingx.no", "No.")} <span data-ing-no>{pad(idx + 1)}</span>
            </div>
            {extras?.family && (
              <div class="text-paper bg-forest/90 absolute start-2 bottom-2 px-2 py-0.5 font-mono text-[9px] tracking-[0.24em] uppercase">
                {ing(extras.family.split("(")[0].trim())}
              </div>
            )}
          </div>

          <div class="p-4 md:p-5">
            <div class="text-moss font-mono text-[9.5px] tracking-[0.28em] uppercase">
              {i.role ? ing(i.role) : t("ingx.botanical", "Botanical")}
            </div>
            <h3 class="text-forest group-hover:text-moss mt-1 font-serif text-lg leading-tight transition-colors md:text-xl">
              {ing(i.name)}
            </h3>
            {i.latin && <p class="text-forest/55 mt-0.5 font-mono text-[11px]">{i.latin}</p>}
            <p class="text-forest/70 mt-2 line-clamp-2 text-[12.5px] leading-relaxed">
              {ing(i.summary ?? i.description)}
            </p>

            {/* Tags */}
            <div class="mt-3 flex flex-wrap gap-1">
              {(extras?.tags ?? []).slice(0, 3).map((tag) => (
                <span class="text-forest/70 bg-ivory hairline border px-1.5 py-0.5 font-mono text-[9px] tracking-[0.2em] uppercase">
                  {ing(tag)}
                </span>
              ))}
            </div>

            {/* Used in */}
            <div class="hairline mt-3 flex items-center justify-between gap-2 border-t pt-3">
              <div class="flex min-w-0 flex-wrap gap-1">
                {i.productSlugs.map((ps) => {
                  const p = productBySlug.get(ps);
                  if (!p) return null;
                  const short = stripBrand(t(`product.${p.slug}.name`, p.name))
                    .split(" ")
                    .slice(0, 2)
                    .join(" ");
                  return (
                    <span class="text-paper bg-forest px-1.5 py-0.5 font-mono text-[9px] tracking-[0.2em] uppercase">
                      {short}
                    </span>
                  );
                })}
              </div>
              <span class="text-forest/50 group-hover:text-moss shrink-0 font-mono text-[10px] transition-colors">
                {t("ingx.open", "Open →")}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  {/* ═════════════ Alphabetical index ═════════════ */}
  <section data-ing-alpha class="container-editorial mt-10 md:mt-16">
    <div class="hairline bg-paper border">
      <div class="hairline flex items-center justify-between border-b p-5 md:p-6">
        <div>
          <h2 class="text-forest font-serif text-xl leading-tight md:text-2xl">
            {t("ingx.alpha", "Alphabetical index")}
          </h2>
        </div>
        <div class="hidden items-center gap-1 md:flex">
          {alphaGroups.map(([letter]) => (
            <a
              href={`#alpha-${letter}`}
              data-ing-letter={letter}
              class="hairline text-forest/70 hover:bg-forest hover:text-paper hover:border-forest border px-2 py-1 font-mono text-[11px] transition-colors"
            >
              {letter}
            </a>
          ))}
        </div>
      </div>
      <div class="divide-y">
        {alphaGroups.map(([letter, list]) => (
          <div
            id={`alpha-${letter}`}
            data-ing-group={letter}
            class="grid scroll-mt-20 grid-cols-[48px_1fr] md:grid-cols-[80px_1fr]"
          >
            <div class="bg-ivory hairline text-forest border-e p-3 font-serif text-2xl md:p-4 md:text-3xl">
              {letter}
            </div>
            <ul class="divide-y">
              {list.map((i) => (
                <li data-ing-item={i.slug}>
                  <a
                    href={withLocalePrefix(`/ingredients/${i.slug}`, locale)}
                    class="hover:bg-ivory/60 group grid grid-cols-[1fr_auto] items-center gap-3 px-4 py-3 transition-colors"
                  >
                    <div class="min-w-0">
                      <div class="text-forest group-hover:text-moss text-[13.5px] leading-tight transition-colors">
                        {ing(i.name)}
                      </div>
                      {i.latin && (
                        <div class="text-forest/50 mt-0.5 font-mono text-[10.5px]">{i.latin}</div>
                      )}
                    </div>
                    <div class="text-forest/50 font-mono text-[10px] tracking-[0.22em] whitespace-nowrap uppercase">
                      {i.role ? ing(i.role) : t("ingx.botanical", "Botanical")} →
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-ing-explorer]")) {
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel);
    const $$ = <T extends Element = HTMLElement>(sel: string) => [...root.querySelectorAll<T>(sel)];

    const input = $<HTMLInputElement>("[data-ing-query]");
    const clear = $("[data-ing-clear]");
    const reset = $("[data-ing-reset]");
    const showing = $("[data-ing-showing]");
    const empty = $("[data-ing-empty]");
    const grid = $("[data-ing-grid]");
    const alpha = $("[data-ing-alpha]");
    const productBtns = $$("[data-ing-product]");
    const themeBtns = $$("[data-ing-theme]");
    const cards = $$("[data-ing-card]");
    const items = $$("[data-ing-item]");
    const groups = $$("[data-ing-group]");
    const letters = $$("[data-ing-letter]");
    const total = root.dataset.total ?? "0";
    const template = root.dataset.showing ?? "{a} / {b}";

    const state = { query: "", theme: "all", product: "all" };

    const apply = () => {
      const q = state.query.trim().toLowerCase();
      const visible = new Set<string>();
      let n = 0;
      for (const card of cards) {
        const show =
          (card.dataset.themes ?? "").split(" ").includes(state.theme) &&
          (state.product === "all" ||
            (card.dataset.products ?? "").split(" ").includes(state.product)) &&
          (!q || (card.dataset.hay ?? "").includes(q));
        card.hidden = !show;
        if (!show) continue;
        n += 1;
        visible.add(card.dataset.ingCard ?? "");
        const no = card.querySelector("[data-ing-no]");
        if (no) no.textContent = String(n).padStart(2, "0");
      }
      for (const item of items) item.hidden = !visible.has(item.dataset.ingItem ?? "");
      for (const group of groups) {
        group.hidden = !group.querySelector("[data-ing-item]:not([hidden])");
      }
      for (const link of letters) {
        link.hidden = !!$(`[data-ing-group="${link.dataset.ingLetter}"][hidden]`);
      }
      for (const btn of productBtns) {
        btn.setAttribute("aria-pressed", String(btn.dataset.ingProduct === state.product));
      }
      for (const btn of themeBtns) {
        btn.setAttribute("aria-pressed", String(btn.dataset.ingTheme === state.theme));
      }

      if (showing) showing.textContent = template.replace("{a}", String(n)).replace("{b}", total);
      if (clear) clear.hidden = !state.query;
      if (reset) reset.hidden = !(state.query || state.theme !== "all" || state.product !== "all");
      if (empty) empty.hidden = n > 0;
      if (grid) grid.hidden = n === 0;
      if (alpha) alpha.hidden = n === 0;
    };

    const resetAll = () => {
      state.query = "";
      state.theme = "all";
      state.product = "all";
      if (input) input.value = "";
      apply();
    };

    input?.addEventListener("input", () => {
      state.query = input.value;
      apply();
    });
    clear?.addEventListener("click", (e) => {
      e.preventDefault();
      state.query = "";
      if (input) input.value = "";
      apply();
    });
    reset?.addEventListener("click", resetAll);
    $("[data-ing-reset-all]")?.addEventListener("click", resetAll);
    for (const btn of productBtns) {
      btn.addEventListener("click", () => {
        state.product = btn.dataset.ingProduct ?? "all";
        apply();
      });
    }
    for (const btn of themeBtns) {
      btn.addEventListener("click", () => {
        state.theme = btn.dataset.ingTheme ?? "all";
        apply();
      });
    }
    // Restore state if the browser kept a typed query (back/forward cache).
    if (input?.value) state.query = input.value;
    apply();
  }
</script>
