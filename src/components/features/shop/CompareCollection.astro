---
/** "Compare the Collection": stacked cards on mobile, table from md up. */
import ResponsiveImage from "@/components/common/ResponsiveImage.astro";
import { productImageAlt, productImageTitle, type Product } from "@/data/products";
import { createT, withLocalePrefix } from "@/lib/i18n";
import { formatMoney, getBasePrice } from "@/lib/pricing";

import { BEST_FOR, STEP_LABELS } from "./shop-data";

export interface Props {
  products: Product[];
  stats: Record<string, { rating: number; count: number }>;
}

const { products, stats } = Astro.props;
const { locale, currency } = Astro.locals;
const t = createT(locale);

const headers = [
  { key: "Product", label: t("shop.table.product", "Product") },
  { key: "Step", label: t("shop.stage", "Stage") },
  { key: "Category", label: t("shop.table.category", "Category") },
  { key: "Size", label: t("shop.table.size", "Size") },
  { key: "Best for", label: t("shop.table.bestFor", "Best for") },
  { key: "Rating", label: t("shop.table.rating", "Rating") },
  { key: "Price", label: t("shop.table.price", "Price") },
];
const thumbWidths = [160];
---

<section class="container-editorial mt-10 md:mt-16">
  <div class="mb-4 flex items-end justify-between">
    <div>
      <h2 class="text-forest font-serif text-2xl md:text-3xl">
        {t("shop.compare.title", "Compare the Collection")}
      </h2>
    </div>
  </div>

  {/* Mobile stacked cards */}
  <div class="bg-ink/10 hairline grid grid-cols-1 gap-px border md:hidden">
    {products.map((p) => {
      const s = stats[p.slug];
      return (
        <div class="bg-paper p-4">
          <div class="flex items-center gap-3">
            <div class="hairline h-14 w-14 shrink-0 overflow-hidden border bg-white">
              <ResponsiveImage
                src={p.image}
                alt={productImageAlt(p, 0, t)}
                title={productImageTitle(p, t)}
                sizes="56px"
                widths={thumbWidths}
                class="h-full w-full object-contain p-1"
              />
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-moss font-mono text-[9px] tracking-[0.28em] uppercase">
                {t(`shop.stepLabel.${p.slug}`, STEP_LABELS[p.slug])}
              </div>
              <div class="text-forest mt-0.5 text-sm leading-tight font-medium">
                {t(`product.${p.slug}.name`, p.name).replace(/®/g, "")}
              </div>
            </div>
            <div class="text-end whitespace-nowrap">
              <div class="text-forest text-sm font-semibold">
                {formatMoney(getBasePrice(p.slug, currency), currency)}
              </div>
              {s && (
                <div class="text-forest/60 mt-0.5 font-mono text-[10px]">
                  ★ {s.rating.toFixed(1)}
                </div>
              )}
            </div>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-x-3 gap-y-1 text-[11.5px]">
            <div class="text-forest/50 font-mono text-[9.5px] tracking-[0.16em] uppercase">
              {t("shop.table.size", "Size")}
            </div>
            <div class="text-forest text-end">{t(`product.${p.slug}.size`, p.size)}</div>
            <div class="text-forest/50 font-mono text-[9.5px] tracking-[0.16em] uppercase">
              {t("shop.table.category", "Category")}
            </div>
            <div class="text-forest text-end">
              {t(`product.category.${p.category}`, p.category)}
            </div>
            <div class="text-forest/50 font-mono text-[9.5px] tracking-[0.16em] uppercase">
              {t("shop.table.bestFor", "Best for")}
            </div>
            <div class="text-forest text-end">{t(`shop.bestFor.${p.slug}`, BEST_FOR[p.slug])}</div>
          </div>
        </div>
      );
    })}
  </div>

  {/* Desktop table */}
  <div class="hairline hidden overflow-x-auto border md:block">
    <table class="text-forest w-full text-sm">
      <thead>
        <tr class="bg-ivory text-start">
          {headers.map((h) => (
            <th
              class:list={[
                "text-forest/60 p-4 font-mono text-[10px] font-normal tracking-[0.24em] uppercase",
                h.key === "Price" ? "text-end" : "text-start",
              ]}
            >
              {h.label}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {products.map((p) => {
          const s = stats[p.slug];
          return (
            <tr class="hairline hover:bg-ivory/50 border-t transition-colors">
              <td class="p-4">
                <a
                  href={withLocalePrefix(`/product/${p.slug}`, locale)}
                  class="group flex items-center gap-3"
                >
                  <div class="hairline h-12 w-12 shrink-0 overflow-hidden border bg-white">
                    <ResponsiveImage
                      src={p.image}
                      alt={productImageAlt(p, 0, t)}
                      title={productImageTitle(p, t)}
                      sizes="48px"
                      widths={thumbWidths}
                      class="h-full w-full object-contain p-1"
                    />
                  </div>
                  <span class="group-hover:text-moss font-medium transition-colors">
                    {t(`product.${p.slug}.name`, p.name)}
                  </span>
                </a>
              </td>
              <td class="text-moss p-4 font-mono text-[12.5px]">
                {t(`shop.stepLabel.${p.slug}`, STEP_LABELS[p.slug])}
              </td>
              <td class="text-forest/70 p-4 text-[12.5px]">
                {t(`product.category.${p.category}`, p.category)}
              </td>
              <td class="text-forest/70 p-4 text-[12.5px]">
                {t(`product.${p.slug}.size`, p.size)}
              </td>
              <td class="text-forest/70 p-4 text-[12.5px]">
                {t(`shop.bestFor.${p.slug}`, BEST_FOR[p.slug])}
              </td>
              <td class="text-forest/70 p-4 font-mono text-[12.5px]">
                {s ? `★ ${s.rating.toFixed(1)} (${(s.count / 1000).toFixed(0)}k)` : "—"}
              </td>
              <td class="p-4 text-end font-semibold whitespace-nowrap">
                {formatMoney(getBasePrice(p.slug, currency), currency)}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</section>
