---
/** Editorial product tile for the /shop catalog grid. */
import ResponsiveImage from "@/components/common/ResponsiveImage.astro";
import type { Product } from "@/data/products";
import { createT, withLocalePrefix } from "@/lib/i18n";
import { formatMoney, getBasePrice } from "@/lib/pricing";

import AddToBag from "./AddToBag";
import { ROLE_LABELS, shorten, STEP_LABELS } from "./shop-data";

export interface Props {
  product: Product;
  stat?: { rating: number; count: number };
}

const { product, stat } = Astro.props;
const { locale, currency } = Astro.locals;
const t = createT(locale);
const href = withLocalePrefix(`/product/${product.slug}`, locale);
const price = getBasePrice(product.slug, currency);
const notes = (product.perfectFor ?? product.benefits ?? [])
  .slice(0, 2)
  .map((b, bi) =>
    shorten(
      product.perfectFor
        ? t(`product.${product.slug}.indications.${bi}`, b)
        : t(`product.${product.slug}.benefits.${bi}`, b),
    ),
  );
---

<div class="bg-paper group relative flex flex-col">
  <a href={href} class="block">
    <div class="relative aspect-square overflow-hidden bg-white">
      <ResponsiveImage
        src={product.image}
        alt={t(
          `product.${product.slug}.imageAlts.0`,
          product.imageAlts?.[0] ?? `${product.name} — ${product.size} product photograph`,
        )}
        sizes="(min-width: 1280px) 380px, (min-width: 768px) 45vw, 100vw"
        class="h-full w-full object-cover transition-transform duration-[1100ms] ease-out group-hover:scale-[1.03]"
      />
      <div class="text-paper bg-forest/90 absolute start-0 top-0 px-2.5 py-1.5 font-mono text-[9px] tracking-[0.28em] uppercase">
        {t(`shop.stepLabel.${product.slug}`, STEP_LABELS[product.slug])}
      </div>
    </div>
  </a>

  <div class="flex flex-1 flex-col p-4 md:p-5">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <div class="text-moss font-mono text-[9.5px] tracking-[0.32em] uppercase">
          {t(`shop.role.${product.slug}`, ROLE_LABELS[product.slug])}
        </div>
        <a href={href} class="block">
          <h3 class="text-forest group-hover:text-moss mt-1 font-serif text-[17px] leading-snug transition-colors md:text-lg">
            {t(`product.${product.slug}.name`, product.name).replace(/®/g, "")}
          </h3>
        </a>
        <div class="text-forest/55 mt-1 font-mono text-[11px]">
          {t(`product.${product.slug}.size`, product.size)} ·{" "}
          {t(`product.category.${product.category}`, product.category)}
        </div>
      </div>
      <div class="text-end whitespace-nowrap">
        <div class="text-forest text-base font-semibold md:text-lg">
          {formatMoney(price, currency)}
        </div>
        {stat && (
          <div class="text-forest/60 mt-1 font-mono text-[10.5px]">
            ★ {stat.rating.toFixed(1)} · {(stat.count / 1000).toFixed(0)}k
          </div>
        )}
      </div>
    </div>

    <div class="mt-3.5 mb-5 flex flex-wrap gap-1.5">
      {notes.map((note) => (
        <span class="text-forest/70 hairline bg-ivory border px-2 py-1 font-mono text-[10px] tracking-[0.16em] uppercase">
          {note}
        </span>
      ))}
    </div>

    <div class="bg-ink/10 hairline mt-auto grid grid-cols-2 gap-px border">
      <a
        href={href}
        class="bg-paper text-forest hover:bg-forest hover:text-paper py-2.5 text-center font-mono text-[10px] tracking-[0.28em] uppercase transition-colors"
      >
        {t("shop.details", "Details →")}
      </a>
      <AddToBag
        client:visible
        lines={[{ slug: product.slug, qty: 1 }]}
        label={t("shop.addToBag", "Add to Bag")}
        className="bg-forest text-paper hover:bg-moss py-2.5 text-center font-mono text-[10px] tracking-[0.28em] uppercase transition-colors"
      />
    </div>
  </div>
</div>
