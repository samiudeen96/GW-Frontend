---
/** Password-reset request form. Submits via `requestPasswordReset` (placeholder). */
import { createT, withLocalePrefix } from "@/lib/i18n";

const { locale } = Astro.locals;
const t = createT(locale);
---

<form
  class="hairline bg-paper space-y-4 border p-8"
  data-reset-form
  data-invalid-email={t("commerce.auth.invalidEmail", "Enter a valid email address.")}
  novalidate
>
  <label
    for="reset-email"
    class="text-ink/60 block text-[10px] font-semibold tracking-[0.15em] uppercase"
  >
    {t("commerce.fields.email", "Email address")}
  </label>
  <input
    id="reset-email"
    name="email"
    type="email"
    autocomplete="email"
    data-ltr
    class="hairline focus:border-forest h-11 w-full border px-3 focus:outline-none"
  />
  <button
    type="submit"
    class="bg-forest text-paper h-11 w-full text-xs font-semibold tracking-[0.2em] uppercase disabled:opacity-50"
  >
    {t("commerce.resetPassword.sendLink", "Send reset link")}
  </button>
  <p
    data-reset-message
    role="status"
    class="border-destructive bg-destructive/5 text-destructive hidden border px-3 py-2 text-xs font-semibold"
  ></p>
  <p class="text-muted-foreground pt-2 text-center text-xs">
    {t("commerce.resetPassword.remembered", "Remembered?")}{" "}
    <a href={withLocalePrefix("/account", locale)} class="underline">
      {t("commerce.resetPassword.signIn", "Sign in")}
    </a>
  </p>
</form>

<script>
  import { requestPasswordReset } from "@/lib/api/account";

  const validEmail = (value: string) => /^\S+@\S+\.\S+$/.test(value);

  document.querySelectorAll<HTMLFormElement>("[data-reset-form]").forEach((form) => {
    const input = form.querySelector<HTMLInputElement>("input[name=email]");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const message = form.querySelector<HTMLElement>("[data-reset-message]");
    if (!input || !button || !message) return;

    const show = (text: string | null) => {
      message.textContent = text ?? "";
      message.classList.toggle("hidden", !text);
    };

    input.addEventListener("input", () => show(null));

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = input.value.trim().toLowerCase();
      if (!validEmail(email)) {
        show(form.dataset.invalidEmail ?? "Enter a valid email address.");
        return;
      }
      button.disabled = true;
      show(null);
      try {
        const res = await requestPasswordReset({ email });
        // TODO(api): show a success notice once the backend sends reset links.
        show(res.ok ? null : res.error);
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
