---
/**
 * Hair-science guide: problems & solutions (tabbed), product roles and combined
 * results. Every problem panel is server-rendered; a small script switches tabs.
 */
import {
  COMBINED_STAGES,
  GUIDE_UI,
  HAIR_PROBLEMS,
  pickL,
  PRODUCT_ROLES,
  SYNERGY_ROWS,
} from "@/data/hair-science-guide";
import { withLocalePrefix } from "@/lib/i18n";

const { locale } = Astro.locals;
const u = (k: string) => pickL(GUIDE_UI[k], locale);
const pad = (n: number) => String(n).padStart(2, "0");
const arrow = locale === "ar" ? "←" : "→";
---

{/* Problems & solutions */}
<section id="problems" class="container-editorial py-14 md:py-20" data-hair-problems>
  <div class="eyebrow mb-3">{u("problemsEyebrow")}</div>
  <h2 class="text-ink max-w-3xl font-serif text-3xl md:text-4xl">{u("problemsTitle")}</h2>
  <p class="text-ink/75 mt-4 max-w-2xl text-[15px] leading-relaxed">{u("problemsIntro")}</p>

  <div class="hairline mt-10 grid border lg:grid-cols-[320px_1fr]">
    <ul class="hairline flex overflow-x-auto border-b lg:block lg:overflow-visible lg:border-e lg:border-b-0">
      {HAIR_PROBLEMS.map((p, i) => (
        <li class="shrink-0">
          <button
            type="button"
            data-problem={p.key}
            aria-pressed={i === 0 ? "true" : "false"}
            class="group hairline bg-paper not-aria-pressed:hover:bg-ivory text-ink aria-pressed:bg-forest aria-pressed:text-paper flex w-full items-baseline gap-3 border-e px-4 py-3 text-start transition-colors lg:border-e-0 lg:border-b lg:py-4"
          >
            <span class="text-ink/40 group-aria-pressed:text-paper/60 font-mono text-[11px]">
              {pad(i + 1)}
            </span>
            <span class="text-sm leading-snug whitespace-nowrap lg:whitespace-normal">
              {pickL(p.name, locale)}
            </span>
          </button>
        </li>
      ))}
    </ul>
    {HAIR_PROBLEMS.map((p, i) => (
      <article data-problem-panel={p.key} hidden={i !== 0} class="bg-paper p-6 md:p-10">
        <h3 class="text-ink font-serif text-2xl md:text-3xl">{pickL(p.name, locale)}</h3>
        <dl class="bg-ink/10 hairline mt-6 grid gap-px border sm:grid-cols-3">
          {(["what", "why", "signs"] as const).map((k) => (
            <div class="bg-paper p-4">
              <dt class="eyebrow mb-2">{u(k)}</dt>
              <dd class="text-ink/80 text-sm leading-relaxed">{pickL(p[k], locale)}</dd>
            </div>
          ))}
        </dl>
        <div class="bg-ivory hairline mt-6 border p-5">
          <div class="eyebrow text-forest mb-3">{u("habits")}</div>
          <ul class="space-y-2">
            {p.habits.map((h) => (
              <li class="text-ink/85 flex gap-3 text-sm leading-relaxed">
                <span class="bg-forest mt-2 h-1.5 w-1.5 shrink-0" />
                <span>{pickL(h, locale)}</span>
              </li>
            ))}
          </ul>
        </div>
        <p class="border-forest text-ink/80 mt-5 border-s-2 ps-4 text-sm leading-relaxed">
          <span class="eyebrow mb-1 block">{u("doctor")}</span>
          {pickL(p.doctor, locale)}
        </p>
      </article>
    ))}
  </div>
</section>

{/* Product roles */}
<section id="products" class="hairline bg-ivory border-y">
  <div class="container-editorial py-14 md:py-20">
    <div class="eyebrow mb-3">{u("productsEyebrow")}</div>
    <h2 class="text-ink mb-10 max-w-3xl font-serif text-3xl md:text-4xl">{u("productsTitle")}</h2>
    <div class="bg-ink/10 hairline grid gap-px border md:grid-cols-2">
      {PRODUCT_ROLES.map((p, i) => (
        <article class="bg-paper flex flex-col p-6 md:p-8">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-ink font-serif text-2xl">{pickL(p.name, locale)}</h3>
            <span class="text-forest/25 font-serif text-3xl">{pad(i + 1)}</span>
          </div>
          <p class="text-ink/80 mt-2 text-[15px] leading-relaxed">{pickL(p.role, locale)}</p>
          <dl class="mt-5 flex-1 space-y-3 text-sm">
            {(["how", "when", "targets"] as const).map((k) => (
              <div class="hairline grid grid-cols-[110px_1fr] gap-3 border-t pt-3">
                <dt class="eyebrow">{u(k)}</dt>
                <dd class="text-ink/80 leading-relaxed">{pickL(p[k], locale)}</dd>
              </div>
            ))}
          </dl>
          <a
            href={withLocalePrefix(`/product/${p.slug}`, locale)}
            class="border-forest text-forest mt-6 self-start border-b pb-1 text-xs tracking-[0.2em] uppercase"
          >
            {u("view")} {arrow}
          </a>
        </article>
      ))}
    </div>
    <div class="bg-forest text-paper mt-8 p-6 md:p-8">
      <div class="eyebrow text-paper/60 mb-2">{u("weekly")}</div>
      <p class="max-w-4xl text-[15px] leading-relaxed">{u("weeklyBody")}</p>
    </div>
  </div>
</section>

{/* Combined results */}
<section id="combined" class="container-editorial py-14 md:py-20">
  <div class="eyebrow mb-3">{u("combinedEyebrow")}</div>
  <h2 class="text-ink mb-10 max-w-3xl font-serif text-3xl md:text-4xl">{u("combinedTitle")}</h2>
  <ol class="border-forest/30 md:bg-ink/10 hairline relative ms-2 border-s-2 md:ms-0 md:grid md:grid-cols-5 md:gap-px md:border md:border-s-0">
    {COMBINED_STAGES.map((s, i) => (
      <li class="relative ps-6 pb-8 md:bg-paper md:p-6">
        <span class="bg-forest absolute -start-[7px] top-1 h-3 w-3 md:hidden" />
        <div class="md:bg-forest md:mb-5 md:h-1" style={`opacity: ${0.35 + i * 0.16}`} />
        <div class="eyebrow text-forest">{pickL(s.range, locale)}</div>
        <h3 class="text-ink mt-1 font-serif text-xl">{pickL(s.title, locale)}</h3>
        <p class="text-ink/75 mt-2 text-sm leading-relaxed">{pickL(s.body, locale)}</p>
        <ul class="mt-3 space-y-1.5">
          {s.results.map((r) => (
            <li class="text-ink/85 flex gap-2 text-sm">
              <span class="text-forest">+</span>
              <span>{pickL(r, locale)}</span>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>

  <h3 class="text-ink mt-14 mb-5 font-serif text-2xl">{u("synergyTitle")}</h3>
  <div class="hairline divide-ink/10 divide-y border">
    {SYNERGY_ROWS.map((r) => (
      <div class="bg-paper grid items-center gap-3 p-4 md:grid-cols-[260px_200px_1fr] md:gap-6 md:p-5">
        <div class="text-ink font-serif text-lg">{pickL(r.combo, locale)}</div>
        <div class="flex gap-1" aria-label={`${r.level}/5`}>
          {Array.from({ length: 5 }, (_, i) => (
            <span class:list={["h-2 flex-1", i < r.level ? "bg-forest" : "bg-ink/10"]} />
          ))}
        </div>
        <div class="text-ink/75 text-sm">{pickL(r.note, locale)}</div>
      </div>
    ))}
  </div>
  <p class="text-muted-foreground mt-6 max-w-3xl text-xs leading-relaxed">{u("note")}</p>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-hair-problems]")) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-problem]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-problem-panel]")];
    for (const btn of buttons) {
      btn.addEventListener("click", () => {
        const key = btn.dataset.problem;
        for (const b of buttons) b.setAttribute("aria-pressed", String(b === btn));
        for (const panel of panels) panel.hidden = panel.dataset.problemPanel !== key;
      });
    }
  }
</script>
