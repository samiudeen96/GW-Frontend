---
import { createT } from "@/lib/i18n";

const t = createT(Astro.locals.locale);
---

<a
  href="https://api.whatsapp.com/send/?phone=97180044674"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={t("misc.whatsapp.ariaLabel", "Chat on WhatsApp")}
  class="group bg-forest text-brass border-brass/70 hover:bg-forest-dark hover:border-brass fixed end-4 bottom-4 z-50 flex h-11 w-11 items-center justify-center border shadow-md transition-all duration-300 hover:shadow-lg md:end-6 md:bottom-6 md:h-14 md:w-14"
>
  <svg
    width="22"
    height="22"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="text-brass"
  >
    <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
    <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"></path>
  </svg>
</a>
