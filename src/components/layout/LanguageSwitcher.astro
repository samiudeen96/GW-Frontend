---
/**
 * Switch between the English (`/path`) and Arabic (`/ar/path`) editions. Plain
 * anchors on purpose: a locale change swaps html lang/dir and fonts.
 */
import { createT, LOCALE_META, LOCALES, withLocalePrefix } from "@/lib/i18n";

export interface Props {
  class?: string;
  variant?: "inline" | "block";
  tone?: "light" | "dark";
}

const { class: className, variant = "inline", tone = "light" } = Astro.props;
const { locale, pathname } = Astro.locals;
const t = createT(locale);
const bare = pathname + Astro.url.search;
const other = LOCALES.find((l) => l !== locale)!;

const labelClass = tone === "dark" ? "text-brass" : "text-ink/50";
const gridClass = tone === "dark" ? "bg-brass/30" : "bg-ink/10";
const activeClass = tone === "dark" ? "bg-brass text-forest" : "bg-forest text-ivory";
const inactiveClass =
  tone === "dark"
    ? "bg-forest text-paper/70 hover:text-paper"
    : "bg-paper text-ink/70 hover:text-forest";
---

{variant === "block" ? (
  <div class={className}>
    <span class:list={["mb-2 block font-mono text-[9px] tracking-[0.24em] uppercase", labelClass]}>
      {t("header.language", "Language")}
    </span>
    <div class:list={["grid grid-cols-2 gap-px", gridClass]}>
      {LOCALES.map((l) => (
        <a
          href={withLocalePrefix(bare, l)}
          hreflang={LOCALE_META[l].htmlLang}
          class:list={[
            "px-3 py-3 text-center text-[11px] tracking-[0.18em] uppercase",
            l === locale ? activeClass : inactiveClass,
          ]}
        >
          {LOCALE_META[l].nativeLabel}
        </a>
      ))}
    </div>
  </div>
) : (
  <a
    href={withLocalePrefix(bare, other)}
    hreflang={LOCALE_META[other].htmlLang}
    aria-label={`${t("header.language", "Language")}: ${LOCALE_META[other].label}`}
    class:list={[
      "text-ink/70 hover:text-forest text-[11px] tracking-[0.18em] uppercase transition-colors",
      className,
    ]}
  >
    {LOCALE_META[other].nativeLabel}
  </a>
)}
