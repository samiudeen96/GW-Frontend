---
import "@/styles/global.css";

export interface Props {
  title: string;
  description?: string;
  lang?: string;
  dir?: "ltr" | "rtl";
}

const { title, description, lang = "en", dir = "ltr" } = Astro.props;

const fontFamilies = [
  "Urbanist:wght@400;500;600;700",
  "Epilogue:wght@300;400;500;600",
  ...(lang === "ar" ? ["IBM+Plex+Sans+Arabic:wght@300;400;500;600;700"] : []),
];
const fontsHref = `https://fonts.googleapis.com/css2?${fontFamilies.map((f) => `family=${f}`).join("&")}&display=swap`;
---

<!doctype html>
<html lang={lang} dir={dir} class={lang === "ar" ? "locale-ar" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
