---
import LegalSections from "@/components/common/LegalSections.astro";
import PageHeader from "@/components/common/PageHeader.astro";
import { cookieSections } from "@/components/features/static/legal/cookie-sections";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { createT } from "@/lib/i18n";
import { translateLegalSections } from "@/lib/legal";
import { breadcrumbLd } from "@/lib/seo";

const t = createT(Astro.locals.locale);

const EN = {
  eyebrow: "Legal",
  title: "Cookie Policy",
  intro:
    "This policy explains the cookies and similar technologies used on greenwealth.com, what each category does, how long it persists, and the controls available to you.",
  seoTitle: "Cookie Policy — Green Wealth",
  seoDescription:
    "How Green Wealth uses essential, functional, analytics and marketing cookies, how long they last, and how to manage or withdraw consent.",
  ogTitle: "Cookie Policy — Green Wealth",
  ogDescription:
    "Cookie categories, retention periods, third-party providers, and how to control cookies on greenwealth.com.",
};

const sections = translateLegalSections(t, "cookie", cookieSections);
const jsonLd = [
  breadcrumbLd([
    { name: "Home", path: "/" },
    { name: "Cookie Policy", path: "/cookie-policy" },
  ]),
];
---

<SiteLayout
  title={t("legal.cookie.seo.title", EN.seoTitle)}
  description={t("legal.cookie.seo.description", EN.seoDescription)}
  ogTitle={t("legal.cookie.seo.ogTitle", EN.ogTitle)}
  ogDescription={t("legal.cookie.seo.ogDescription", EN.ogDescription)}
  path="/cookie-policy"
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow={t("legal.cookie.eyebrow", EN.eyebrow)}
    title={t("legal.cookie.title", EN.title)}
    intro={t("legal.cookie.intro", EN.intro)}
  />
  <LegalSections sections={sections} numbered />
</SiteLayout>
