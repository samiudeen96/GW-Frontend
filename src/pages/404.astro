---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { createT, withLocalePrefix } from "@/lib/i18n";

const { locale } = Astro.locals;
const t = createT(locale);
---

<SiteLayout title="Page not found | Green Wealth" noindex>
  <div class="container-editorial flex min-h-[60vh] items-center justify-center">
    <div class="max-w-md text-center">
      <div class="eyebrow mb-6">404 · Not Found</div>
      <h1 class="display-lg">
        {t("common.notFoundTitle", "The page you are looking for cannot be found.")}
      </h1>
      <a
        href={withLocalePrefix("/", locale)}
        class="bg-forest text-ivory mt-8 inline-block px-6 py-3 text-xs tracking-[0.18em] uppercase"
      >
        {t("common.returnHome", "Return Home")}
      </a>
    </div>
  </div>
</SiteLayout>
