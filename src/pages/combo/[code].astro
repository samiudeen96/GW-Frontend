---
/** /combo/:code: a curated combo with its lines, set pricing and other sets. */
import PageHeader from "@/components/common/PageHeader.astro";
import ResponsiveImage from "@/components/common/ResponsiveImage.astro";
import AddToBag from "@/components/features/shop/AddToBag";
import { comboPricing, comboProducts } from "@/data/combos";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getComboByCode, getCombos } from "@/lib/api/catalog";
import { createT, withLocalePrefix } from "@/lib/i18n";
import { imageUrl } from "@/lib/images";
import { formatMoney } from "@/lib/pricing";
import { abs, breadcrumbLd, canonicalFor } from "@/lib/seo";

const { locale, currency } = Astro.locals;
const t = createT(locale);

const combo = await getComboByCode(Astro.params.code ?? "");
if (!combo) return new Response(null, { status: 404 });

const allCombos = await getCombos();
const path = `/combo/${combo.code.toLowerCase()}`;
const url = canonicalFor(path, locale);
const lines = comboProducts(combo);
const images = lines.map(({ product }) => abs(imageUrl(product.image)));

const comboName = t(`shop.combo.${combo.code}.name`, combo.name);
const comboStep = t(`shop.combo.${combo.code}.step`, combo.step);
const comboPurpose = t(`shop.combo.${combo.code}.purpose`, combo.purpose);
const comboDescription = t(`shop.combo.${combo.code}.description`, combo.description);
const title = locale === "ar" ? `${comboName} — جرين ولث` : `${combo.name} — Green Wealth`;
const { total, reference, savings, units } = comboPricing(combo, currency);
const usdPrice = comboPricing(combo, "USD").total.toFixed(2);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: combo.name,
    description: combo.description,
    sku: combo.code,
    brand: { "@type": "Brand", name: "Green Wealth" },
    image: images,
    offers: {
      "@type": "AggregateOffer",
      url,
      priceCurrency: "USD",
      lowPrice: usdPrice,
      highPrice: usdPrice,
      offerCount: lines.length,
      availability: "https://schema.org/InStock",
      itemCondition: "https://schema.org/NewCondition",
      priceValidUntil: `${new Date().getFullYear() + 1}-12-31`,
    },
  },
  breadcrumbLd([
    { name: "Home", path: "/" },
    { name: "Shop", path: "/shop" },
    { name: combo.name, path },
  ]),
];
---

<SiteLayout
  title={title}
  description={comboDescription}
  path={path}
  type="product"
  image={images[0]}
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow={`${t("shop.combo.curated", "Curated Combo")} · ${comboStep}`}
    title={comboName}
    intro={comboDescription}
  />

  <section class="container-editorial mt-10 md:mt-16">
    <div class="bg-ink/10 hairline grid grid-cols-1 gap-px border lg:grid-cols-[1fr_380px]">
      <div class="bg-paper p-6 md:p-10">
        <div class="text-moss mb-4 font-mono text-[9.5px] tracking-[0.28em] uppercase">
          {comboStep}
        </div>
        <div class="flex items-start justify-between gap-4">
          <h2 class="text-forest font-serif text-2xl leading-tight md:text-3xl">{comboName}</h2>
          {combo.featured && (
            <span class="text-forest border-gold shrink-0 border px-2 py-1 font-mono text-[9px] tracking-[0.24em] whitespace-nowrap uppercase">
              {t("shop.combo.mostChosen", "Most chosen")}
            </span>
          )}
        </div>
        <p class="text-forest/75 mt-5 max-w-2xl text-[14px] leading-relaxed">{comboPurpose}</p>

        <div class="bg-ink/10 hairline mt-8 grid grid-cols-2 gap-px border md:grid-cols-3 lg:grid-cols-4">
          {lines.map(({ product, qty }) => (
            <a
              href={withLocalePrefix(`/product/${product.slug}`, locale)}
              class="group relative aspect-square bg-white"
            >
              <ResponsiveImage
                src={product.image}
                alt={t(
                  `product.${product.slug}.imageAlts.0`,
                  product.imageAlts?.[0] ?? `${product.name} — product photograph`,
                )}
                sizes="(min-width: 1024px) 220px, 50vw"
                class="h-full w-full object-contain p-3 transition-transform group-hover:scale-[1.02]"
              />
              {qty > 1 && (
                <span class="text-forest bg-paper hairline absolute end-2 bottom-2 border px-1.5 font-mono text-[10px]">
                  ×{qty}
                </span>
              )}
            </a>
          ))}
        </div>

        <ul class="text-forest/70 mt-8 space-y-2 font-mono text-[13px]">
          {lines.map(({ product, qty }) => (
            <li class="hairline flex justify-between gap-3 border-b pb-2">
              <span>
                {qty > 1 ? `${qty} × ` : ""}
                {t(`product.${product.slug}.name`, product.name)}
              </span>
              <a
                href={withLocalePrefix(`/product/${product.slug}`, locale)}
                class="text-moss whitespace-nowrap underline underline-offset-2"
              >
                {t("shop.combo.viewProduct", "View product")}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-ivory hairline border-t p-6 md:p-10 lg:border-s lg:border-t-0">
        <div class="text-moss font-mono text-[9.5px] tracking-[0.28em] uppercase">
          {units} {units === 1 ? t("shop.combo.unit", "unit") : t("shop.combo.units", "units")}
        </div>
        <div class="mt-3 flex items-baseline gap-3">
          <span class="text-forest font-serif text-3xl md:text-4xl">
            {formatMoney(total, currency)}
          </span>
          {savings > 0 && (
            <span class="text-forest/45 font-mono text-[15px] line-through">
              {formatMoney(reference, currency)}
            </span>
          )}
        </div>
        {savings > 0 && (
          <div class="text-moss mt-2 font-mono text-[11px] tracking-[0.24em] uppercase">
            {`${t("shop.combo.saveTogether", "Save")} ${formatMoney(savings, currency)} ${t("shop.combo.whenBoughtTogether", "when bought together")}`}
          </div>
        )}

        <AddToBag
          client:visible
          lines={combo.lines}
          label={t("shop.combo.addComboToBag", "Add combo to bag")}
          className="mt-8 w-full bg-forest py-4 font-mono text-[11px] tracking-[0.28em] text-paper uppercase transition-colors hover:bg-moss"
        />

        <div class="text-forest/60 mt-6 space-y-2 font-mono text-[11px]">
          <div class="flex justify-between">
            <span>{t("shop.trust.authenticity", "Authenticity")}</span>
            <span class="text-forest">
              {t("shop.trust.scratchVerified", "Scratch-code verified")}
            </span>
          </div>
          <div class="flex justify-between">
            <span>{t("shop.combo.shipping", "Shipping")}</span>
            <span class="text-forest">{t("shop.combo.worldwide", "Worldwide")}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-editorial mt-10 pb-20 md:mt-16">
    <div class="hairline bg-paper border p-6 md:p-8">
      <h2 class="text-forest font-serif text-xl md:text-2xl">
        {t("shop.combo.moreCuratedSets", "More curated sets")}
      </h2>
      <div class="bg-ink/10 hairline mt-5 grid grid-cols-1 gap-px border md:grid-cols-2 lg:grid-cols-3">
        {allCombos
          .filter((c) => c.code !== combo.code)
          .map((c) => (
            <a
              href={withLocalePrefix(`/combo/${c.code.toLowerCase()}`, locale)}
              class="bg-paper hover:bg-ivory/50 block p-5 transition-colors"
            >
              <div class="text-moss font-mono text-[9px] tracking-[0.28em] uppercase">
                {t(`shop.combo.${c.code}.step`, c.step)}
              </div>
              <div class="text-forest mt-1 font-serif text-[15px] leading-snug">
                {t(`shop.combo.${c.code}.name`, c.name)}
              </div>
            </a>
          ))}
      </div>
    </div>
  </section>
</SiteLayout>
