---
/** Thank-you page after an order is placed (`?order=<number>` shows the reference). */
import PageHeader from "@/components/common/PageHeader.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { createT, withLocalePrefix } from "@/lib/i18n";

const { locale } = Astro.locals;
const t = createT(locale);
const isAr = locale === "ar";
const order = Astro.url.searchParams.get("order");
---

<SiteLayout
  title={isAr ? "تم تأكيد الطلب — Green Wealth" : "Order Confirmed — Green Wealth"}
  description={
    isAr
      ? "شكرًا لطلبك من Green Wealth. غسول Neo Hair Lotion في طريقه إليك."
      : "Thank you for your Green Wealth order. Your Neo Hair Lotion is on its way."
  }
  path="/order-confirmation"
  robots="noindex, follow"
>
  <PageHeader
    eyebrow={t("commerce.confirmation.eyebrow", "Thank you")}
    title={t("commerce.confirmation.title", "Order confirmed")}
  />
  <div class="container-editorial max-w-2xl py-10 md:py-20">
    <div class="hairline bg-paper border p-8 text-center md:p-12">
      <h2 class="mb-3 font-serif text-2xl">
        {t("commerce.confirmation.received", "Your order has been received")}
      </h2>
      {order && (
        <p class="mb-6 text-xs tracking-[0.2em] uppercase">
          {t("commerce.confirmation.reference", "Order reference")} ·{" "}
          <span class="font-semibold">{order}</span>
        </p>
      )}
      <p class="text-muted-foreground mb-8 text-sm leading-relaxed">
        {t(
          "commerce.confirmation.body",
          "A confirmation email is on its way with your order details, tracking information, and the 120-day protocol guide.",
        )}
      </p>

      <div class="flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href={withLocalePrefix("/track-order", locale)}
          class="bg-forest text-paper px-6 py-3 text-center text-xs font-semibold tracking-[0.2em] uppercase"
        >
          {t("commerce.confirmation.trackOrder", "Track your order")}
        </a>
        <a
          href={withLocalePrefix("/how-to-use", locale)}
          class="hairline border px-6 py-3 text-center text-xs font-semibold tracking-[0.2em] uppercase"
        >
          {t("commerce.confirmation.readProtocol", "Read the protocol")}
        </a>
      </div>
    </div>
  </div>
</SiteLayout>
