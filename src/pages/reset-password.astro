---
import PageHeader from "@/components/common/PageHeader.astro";
import ResetPasswordForm from "@/components/features/account/ResetPasswordForm.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { createT } from "@/lib/i18n";

const { locale } = Astro.locals;
const t = createT(locale);
const title =
  locale === "ar" ? "إعادة تعيين كلمة المرور — Green Wealth" : "Reset password — Green Wealth";
---

<SiteLayout title={title} path="/reset-password" robots="noindex, nofollow">
  <PageHeader
    eyebrow={t("commerce.resetPassword.eyebrow", "Account")}
    title={t("commerce.resetPassword.title", "Reset your password")}
  />
  <div class="container-editorial max-w-md py-10 md:py-16">
    <ResetPasswordForm />
  </div>
</SiteLayout>
