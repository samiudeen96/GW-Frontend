---
/** Bag page. The cart is client state (localStorage), so the body is an island. */
import CartView from "@/components/features/checkout/CartView";
import CartTrustBanner from "@/components/social/CartTrustBanner.astro";
import CustomerQuote from "@/components/social/CustomerQuote.astro";
import { productImageTitle } from "@/data/products";
import { shippingForCurrency } from "@/data/shipping";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getProducts } from "@/lib/api/catalog";
import { buildCartCatalog } from "@/lib/cart-catalog";
import { createT, islandI18n } from "@/lib/i18n";

const { locale, currency } = Astro.locals;
const t = createT(locale);
const catalog = await buildCartCatalog(locale, currency);
const imageTitles = Object.fromEntries(
  (await getProducts()).map((p) => [p.slug, productImageTitle(p, t)]),
);
const title = locale === "ar" ? "حقيبتك — Green Wealth" : "Your Bag — Green Wealth";
---

<SiteLayout title={title} path="/cart" noindex>
  <CartView
    client:load
    catalog={catalog}
    currency={currency}
    shipping={shippingForCurrency(currency)}
    imageTitles={imageTitles}
    i18n={islandI18n(locale, ["commerce.cart.", "commerce.summary.", "commerce.trust."])}
  >
    <CartTrustBanner slot="trust-banner" />
    <CustomerQuote slot="quote" compact />
  </CartView>
</SiteLayout>
